.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.ipynb_checkpoints
.ipynb_checkpoints/

# --- credentials
kaggle.json
.kaggle/
.env

# --- OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

