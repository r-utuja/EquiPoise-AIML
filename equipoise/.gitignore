# --- data: DRCR terms forbid redistribution; only synthetic data is committed
/data/*
!/data/synthetic/
!/data/.gitignore
# DVC pointer files for data are fine to commit
!/data/*.dvc

# --- artifacts
/models/
/mlruns/
mlflow.db
/logs/
/reports/**/*.html
/reports/synthetic/

